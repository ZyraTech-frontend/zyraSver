# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://admin:password@zyratech-db.xxxxx.us-east-1.rds.amazonaws.com:5432/zyratech_dev

# Supabase Storage (S3-compatible)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-supabase-s3-access-key
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-key
AWS_S3_BUCKET=zyratech-assets
S3_ENDPOINT=https://YOUR_PROJECT_ID.supabase.co/storage/v1/s3

# API Configuration
NODE_ENV=development
API_PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Passwords
BCRYPT_ROUNDS=12

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@zyratechhub.com

# Payment (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Logging
LOG_LEVEL=debug
